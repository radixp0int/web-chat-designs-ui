# Streams chat responses from the mock WebSocket server (chat-ws-server).
# Comment this out to fall back to the built-in canned responder.
VITE_WS_URL=ws://localhost:8787

# Drives the workflow canvas from the mock run server (workflow-ws-server).
# Commented out until that server is on main: uncomment it once the repo is
# there, and /workflow-live switches from the hard-coded run to live ones.
#VITE_WORKFLOW_WS_URL=ws://localhost:8788
