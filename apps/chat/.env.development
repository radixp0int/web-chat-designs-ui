# Streams chat responses from the mock WebSocket server (chat-ws-server).
# Comment this out to fall back to the built-in canned responder.
VITE_WS_URL=ws://localhost:8787

# The workflows app, a separate deploy — where the landing page's workflow
# cards go. Its dev server is pinned to 5174 (apps/workflows/vite.config.ts).
VITE_WORKFLOWS_URL=http://localhost:5174
