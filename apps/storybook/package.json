{
  "name": "@chat/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "One Storybook for every module in the repo. Stories live beside their components; this workspace holds the config, the theme toolbar, the docs and the release notes.",
  "type": "module",
  "scripts": {
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chat/chat-ui": "*",
    "@chat/tokens": "*",
    "@chat/ui": "*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
