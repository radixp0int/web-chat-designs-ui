{
  "name": "chat-interfaces",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w apps/chat",
    "dev:workflows": "npm run dev -w apps/workflows",
    "build": "npm run build --workspaces --if-present",
    "build:widget": "npm run build:widget -w apps/chat",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "npm run preview -w apps/chat",
    "preview:workflows": "npm run preview -w apps/workflows",
    "preview:widget": "npm run preview:widget -w apps/chat",
    "prepare": "node .husky/install.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.70.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
