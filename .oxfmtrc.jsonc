{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    "dist-widget/**",
    "package-lock.json",
    // Per-machine Claude Code settings — ignored by git globally, never formatted.
    ".claude/settings.local.json",
  ],
}
