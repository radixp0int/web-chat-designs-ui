{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chat",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/chat"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "workflows",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/workflows"],
      "port": 5174
    },
    {
      "name": "widget-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview:widget", "-w", "apps/chat"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "chat-ws-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../chat-ws-server", "run", "dev"],
      "port": 8787
    },
    {
      "name": "workflow-ws-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../workflow-ws-server", "run", "dev"],
      "port": 8788
    }
  ]
}
